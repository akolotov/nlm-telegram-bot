# Gemini Notebook authentication data inside the container. The Compose file
# mounts the host-side ./.nlm-runtime directory here.
NOTEBOOKLM_MCP_CLI_PATH=/state/notebooklm

# Telegram bot token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Comma-separated Telegram numeric user IDs allowed to use the bot.
ALLOWED_USER_IDS=123456789

# Unique for each production or staging deployment.
COMPOSE_PROJECT_NAME=nlm-telegram-bot-staging

# Published image defaults. Use an exact local tag and `never` for local builds.
BOT_IMAGE=ghcr.io/akolotov/nlm-telegram-bot:latest
BOT_PULL_POLICY=always

# Public Tailscale Funnel endpoint and matching ingress route.
WEBHOOK_PUBLIC_BASE_URL=https://your-funnel-host.example
WEBHOOK_DOCKER_ALIAS=nlm-telegram-bot-staging
WEBHOOK_PATH=/hooks/nlm-telegram-bot-staging/telegram/webhook
WEBHOOK_SECRET_TOKEN=replace-with-a-random-secret

LOG_LEVEL=INFO
